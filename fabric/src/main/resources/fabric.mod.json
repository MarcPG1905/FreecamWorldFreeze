{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",

  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [ "MarcPG" ],
  "icon": "icon.png",
  "license": "MIT",

  "contact": {
    "sources": "${modGitHubUrl}",
    "issues": "${modGitHubUrl}/issues"
  },

  "environment": "client",

  "entrypoints": {
    "client": [ "com.marcpg.fwf.FWFFabric" ],
    "modmenu": [ "com.marcpg.fwf.ModMenuIntegration" ]
  },

  "mixins": [
    {
      "config": "${modId}.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "minecraft": ">=${minMinecraftVersion}",
    "fabricloader": "*",
    "freecam": "*"
  },

  "recommends": {
    "modmenu": "*",

    "camenh": "*",
    "cameratweaks": "*",
    "easy-freecam": "*",
    "freecam": "*",
    "freecam_by_jasonzli": "*",
    "freecam_by_kapiteon": "*",
    "wi_freecam": "*",
    "zergatulfreecam": "*"
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/HvWhqY3kRG",
        "modmenu.modrinth": "https://modrinth.com/mod/freecam-wf",
        "modmenu.github_releases": "${modGitHubUrl}/releases"
      }
    }
  }
}
